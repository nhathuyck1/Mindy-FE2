API_BASE_URL=https://api.quanh123.id.vn/api/v1
APP_ORIGIN=http://localhost:3003

# Public CKEditor key. GPL is for projects complying with CKEditor's GPL terms.
# Replace with your self-hosted commercial key when applicable; restart/rebuild Next.js.
NEXT_PUBLIC_CKEDITOR_LICENSE_KEY=GPL

# Runtime browser-reachable backend origin for chat + whiteboards (HTTP(S), no path).
# Optional when API_BASE_URL already uses the public backend hostname.
# Set explicitly when API_BASE_URL is an internal Docker/VPC URL.
# REALTIME_ORIGIN=https://api.example.com
# On host/domain change: set APP_ORIGIN to the exact FE origin and allow it in BE CORS_ORIGINS.
